{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-I",
                "include",
                "-I",
                "lib/raylib/src",
                // "-I", "C:/testeraylib5/raylib-5.0/src",
                "-I",
                "lib/imgui",
                "-I",
                "lib/imgui/backends",
                "-I",
                "lib/implot",
                "-I",
                "lib/ImGuiFileDialog",
                "-I",
                "lib/rlImGui",
                "-I",
                "lib/cereal/include",
                "-L",
                "lib/raylib/build",
                // "-L", "C:/testeraylib5/raylib-5.0/src",
                "-L",
                "lib/imgui/build",
                "-L",
                "lib/implot/build",
                // "-L", "lib/rlImGui/build",
                "-g",
                "src/recursos.o",
                "-o",
                "build/main.exe",
                "src/main.cpp",
                "src/Interface.cpp",
                "src/Point.cpp",
                "src/Polygon.cpp",
                "src/Reinforcement.cpp",
                "src/ConcreteProperties.cpp",
                "src/SteelProperties.cpp",
                "src/StrainDistribution.cpp",
                "src/PolygonStressREgions.cpp",
                "src/AnalyticalIntegration.cpp",
                "src/InternalForces.cpp",
                "src/MomentSolver.cpp",
                "src/Section.cpp",
                "src/combination.cpp",
                "lib/rlImGui/rlImGui.cpp",
                "lib/ImGuiFileDialog/ImGuiFileDialog.cpp",
                "-l:libimgui.a",
                "-l:libimplot.a",
                "-l:libraylib.a",
                // "-l:librlImGui.a",
                "-lwinmm",
                "-lgdi32",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compilação do projeto com raylib, imgui, implot e rlImGui"
        },
        {
            "label": "build-release-performance",
            "type": "shell",
            "command": "g++",
            "args": [
                // --- Otimizações ---
                "-O3", // Otimização agressiva para velocidade
                "-DNDEBUG", // Remove código de debug das bibliotecas
                "-s", // Remove símbolos do executável para reduzir o tamanho
                // -------------------
                "-std=c++17",
                "-I",
                "include",
                "-I",
                "lib/raylib/src",
                "-I",
                "lib/imgui",
                "-I",
                "lib/imgui/backends",
                "-I",
                "lib/implot",
                "-I",
                "lib/ImGuiFileDialog",
                "-I",
                "lib/rlImGui",
                "-I",
                "lib/cereal/include",
                "-L",
                "lib/raylib/build",
                "-L",
                "lib/imgui/build",
                "-L",
                "lib/implot/build",
                "src/recursos.o",
                "-o",
                "build/main-release.exe", // Nome diferente para o executável de release
                "src/main.cpp",
                "src/Interface.cpp",
                "src/Point.cpp",
                "src/Polygon.cpp",
                "src/Reinforcement.cpp",
                "src/ConcreteProperties.cpp",
                "src/SteelProperties.cpp",
                "src/StrainDistribution.cpp",
                "src/PolygonStressREgions.cpp",
                "src/AnalyticalIntegration.cpp",
                "src/InternalForces.cpp",
                "src/MomentSolver.cpp",
                "src/Section.cpp",
                "src/combination.cpp",
                "lib/rlImGui/rlImGui.cpp",
                "lib/ImGuiFileDialog/ImGuiFileDialog.cpp",
                "-l:libimgui.a",
                "-l:libimplot.a",
                "-l:libraylib.a",
                "-lwinmm",
                "-lgdi32",
            ],
            "group": "build", // Pode deixar fora do grupo "default"
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compilação de RELEASE otimizada para VELOCIDADE"
        }
    ]
}